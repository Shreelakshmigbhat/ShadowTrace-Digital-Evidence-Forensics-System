# Copy to .env.local and fill in values. .env.local is git-ignored.

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=shadowtrace        # the SQL files say "USE shadowtrace", so keep this name
MYSQL_USER=shadowtrace_app        # non-root application user (created by docker-compose)
MYSQL_PASSWORD=                   # choose a password for the app user
MYSQL_ROOT_PASSWORD=              # used only by docker-compose and `npm run db:reset`

# Optional, local MySQL without Docker: path to the mysql client used by `npm run db:reset`
# MYSQL_CLI_PATH="C:/Program Files/MySQL/MySQL Server 8.0/bin/mysql.exe"

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=shadowtrace

# --- Auth ---
# Signs the session cookie. Must be 32+ random characters, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
